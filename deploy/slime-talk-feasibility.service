[Unit]
Description=slime talk experimental PTT controller
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=slime-talk
Group=slime-talk
WorkingDirectory=/opt/slime-talk-feasibility/controller
EnvironmentFile=/etc/slime-talk-feasibility/controller.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
[Install]
WantedBy=multi-user.target
